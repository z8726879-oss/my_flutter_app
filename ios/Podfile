# جلب مسار Flutter الافتراضي سحابياً
flutter_root = ENV['FLUTTER_ROOT'] || File.expand_path(File.join('..', '..', 'flutter'))
if !File.exist?(flutter_root)
  flutter_root = File.expand_path(File.join('..', '..'))
end

require File.expand_path(File.join(flutter_root, 'packages', 'flutter_tools', 'bin', 'podhelper.rb'))

platform :ios, '13.0'

# 🌟 إجبار الكوكوبودز على تفعيل الرؤوس النمطية لكافة الحزم يدوياً
use_modular_headers!

target 'Runner' do
  # 🌟 التغيير الحاسم: قمنا بحذف سطر !use_frameworks وتحويله لـ Static Link لتفادي أخطاء عزل الملفات
  use_frameworks! :linkage => :static

  flutter_install_all_ios_pods File.dirname(File.expand_path(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    target.build_configurations.each do |config|
      # تمرير كافة إعدادات الأمان والتوافق الصارمة للـ Xcode
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      config.build_settings['DEFINES_MODULE'] = 'YES'
    end
  end

  # تعديل ملفات التكوين الموجهة للمترجم لفرض تخطي الفحص الأمني
  sandbox_dir = installer.sandbox.root
  Dir.glob("#{sandbox_dir}/Pods-Runner.*.xcconfig").each do |xcconfig_path|
    File.open(xcconfig_path, 'a') do |file|
      file.puts "\nCLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES = YES"
    end
  end
  
  # حقن نفس الخيار في ملف إعدادات حزمة firebase_messaging المستقلة
  Dir.glob("#{sandbox_dir}/Target Support Files/firebase_messaging/*.xcconfig").each do |xcconfig_path|
    File.open(xcconfig_path, 'a') do |file|
      file.puts "\nCLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES = YES"
    end
  end
end
