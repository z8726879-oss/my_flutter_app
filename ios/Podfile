platform :ios, '13.0'

use_frameworks!
use_modular_headers!

flutter_root = File.expand_path(File.join('..', '..', '..', '..', 'flutter'), __FILE__)
if !File.directory?(flutter_root)
  flutter_root = File.expand_path(File.join('..', '..', 'flutter'), __FILE__)
end

require File.join(flutter_root, 'packages', 'flutter_tools', 'bin', 'podhelper')

target 'Runner' do
  flutter_install_all_ios_pods File.dirname(__FILE__)
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
    end
  end
end
