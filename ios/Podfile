# جلب مسار Flutter من متغيرات بيئة النظام مباشرة
flutter_root = ENV['FLUTTER_ROOT'] || File.expand_path(File.join('..', '..', 'flutter'))
if !File.exist?(flutter_root)
  flutter_root = File.expand_path(File.join('..', '..'))
end

require File.expand_path(File.join(flutter_root, 'packages', 'flutter_tools', 'bin', 'podhelper.rb'))

platform :ios, '13.0'

# تفعيل الرؤوس النمطية الإلزامية لحزم الـ Objective-C الكلاسيكية مثل Firebase
use_modular_headers!

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.expand_path(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    # 1️⃣ فرض الإعدادات الأمنية على مستوى جميع الأهداف والتحضيرات
    target.build_configurations.each do |config|
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      config.build_settings['DEFINES_MODULE'] = 'YES'
    end
  end

  # 🌟 2️⃣ الحل السحري والتاريخي: حذف مسار الرؤوس العامة لـ Firebase من حزمة firebase_messaging قسرياً!
  # هذا السطر يدخل إلى ملفات المترجم النصية الخاصة بالديباج والريليز ويحذف الرابط المسبب للأزمة تماماً
  sandbox_dir = installer.sandbox.root
  Dir.glob("#{sandbox_dir}/Target Support Files/firebase_messaging/*.xcconfig").each do |xcconfig_path|
    config_text = File.read(xcconfig_path)
    # إزالة مسارات الرؤوس القديمة المعزولة التي تسببت في اعتراض Xcode الأمني
    updated_config = config_text.gsub('-I"${PODS_ROOT}/Headers/Public/Firebase"', '')
    File.open(xcconfig_path, "w") { |file| file.puts updated_config }
  end
end
